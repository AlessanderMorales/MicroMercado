@page
@model MicroMercado.Presentation.Pages.ClientPageModel

@{
    ViewData["Title"] = "Lista de Clientes";
    Layout = "~/Presentation/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <style>
        .card-header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <a asp-page="/NewClient" class="btn btn-primary mb-2">
                    <i class="fas fa-plus-circle"></i> Agregar Nuevo Cliente
                </a>
                <h1 class="m-0">
                    <i class="fas fa-users text-primary"></i>
                    Lista de Clientes
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
                    <li class="breadcrumb-item active">Clientes</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }


        <div class="table-responsive shadow-sm rounded-3">
            <table id="categoryTable" class="table align-middle">
                <thead class="table-dark text-center">
                <tr>
                    <th  style="width:5%; text-align:center;">#</th>
                    <th  style="width:25%; text-align:center;">Nombre/Razón Social</th>
                    <th  style="width:35%; text-align:center;">Email</th>
                    <th  style="width:12%; text-align:center;">NIT/CI</th>
                    <th  style="width:23%; text-align:center;">Acciones</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Clients.Select((item, index) => new { item, index = index + 1 }))
                {
                    <tr>
                        <td style="text-align:center;">@t.index</td>
                        <td>@t.item.BusinessName</td>
                        <td>@t.item.Email</td>
                        <td>@t.item.TaxDocument</td>
                        <td class="text-center">
                            <a asp-page="/EditCategory" asp-route-id="@t.item.Id" class="btn btn-warning btn-sm me-1" title="Editar Categoría">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="confirmDeleteCategory(@t.item.Id, '@t.item.BusinessName')"
                                    title="Eliminar Categoría">
                                <i class="fas fa-trash-alt"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar al cliente <strong id="clientNameToDelete"></strong>? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" id="deleteClientForm" asp-page-handler="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="clientIdToDelete" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#categoryTable').DataTable({
                pageLength: 15,
                language: {
                    lengthMenu: `<div class="input-group input-group-sm">
                                    <span class="input-group-text">Registros por página</span>
                                    <span class="mx-2">_MENU_</span>
                                </div>`,
                    zeroRecords: 'No se encontraron resultados',
                    info: 'Mostrando _START_ a _END_ de _TOTAL_ registros',
                    infoEmpty: 'Mostrando 0 a 0 de 0 registros',
                    infoFiltered: '(filtrados de _MAX_ registros totales)',
                    search: '',
                    searchPlaceholder: 'Buscar...',
                    paginate: {
                        first: 'Primero',
                        previous: 'Anterior',
                        next: 'Siguiente',
                        last: 'Último'
                    }
                },
                ordering: true,
                columnDefs: [
                    { orderable: false, targets: 3 },
                    { type: 'num', targets: 0 }
                ],
                order: [[0, 'asc']],
                dom: '<"row align-items-center mb-3"' + 
                     '<"col-12 col-sm-6"l>' + 
                     '<"col-12 col-sm-6"f>>' + 
                     '<"row"<"col-sm-12"tr>>' + 
                     '<"row align-items-center mt-3"' + 
                     '<"col-12 col-sm-5"i>' + 
                     '<"col-12 col-sm-7"p>>',
                classes: {
                    sLengthSelect: 'form-select form-select-sm',
                    sFilterInput: 'form-control form-control-sm',
                    wrapper: 'dataTables_wrapper dt-bootstrap5'
                }
            });
            var searchInput = $('.dataTables_filter input');
            searchInput.unwrap().wrap('<div class="input-group input-group-sm"></div>');
            searchInput.before('<span class="input-group-text"><i class="fas fa-search"></i></span>');
            searchInput.addClass('form-control');
        });

        function confirmDeleteCategory(categoryId, categoryName) {
            document.getElementById('categoryIdToDelete').value = categoryId;
            document.getElementById('categoryNameToDelete').innerText = categoryName;
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmationModal'));
            deleteModal.show();
        }
    </script>
}